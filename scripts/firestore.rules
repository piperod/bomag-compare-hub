rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can append a login event. Reads are allowed so admins can export
    // Excel from the app (this static site has no Firebase Auth).
    match /loginEvents/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['username', 'name', 'timestamp'])
        && request.resource.data.username is string
        && request.resource.data.name is string
        && request.resource.data.timestamp is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() < 128;
      allow read: if true;
      allow update, delete: if false;
    }

    // Email collected after the first password login, used for passwordless sign-in.
    match /userEmails/{username} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['username', 'email'])
        && request.resource.data.username == username
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 160;
      allow delete: if false;
    }
  }
}
