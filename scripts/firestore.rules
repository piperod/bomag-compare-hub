rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can append a login event; nobody can read/update/delete from the client.
    // View logs in Firebase Console → Firestore → loginEvents
    match /loginEvents/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['username', 'name', 'timestamp'])
        && request.resource.data.username is string
        && request.resource.data.name is string
        && request.resource.data.timestamp is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() < 128;
      allow read, update, delete: if false;
    }
  }
}
