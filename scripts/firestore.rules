rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can append a login event. Reads are allowed so admins can export
    // Excel from the app (this static site has no Firebase Auth).
    match /loginEvents/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['username', 'name', 'timestamp'])
        && request.resource.data.username is string
        && request.resource.data.name is string
        && request.resource.data.timestamp is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() < 128;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
